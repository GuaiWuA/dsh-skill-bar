{
  "name": "dsh-client-ui-skill-bar",
  "version": "0.1.0",
  "description": "Skill bar for the DSH web GUI: every user-invocable skill of the session as a card you can search, favorite, and cast into the composer as /<name>",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis-plugin",
    "dsh-plugin",
    "skill",
    "skills",
    "web-ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GuaiWuA/dsh-skill-bar.git"
  },
  "homepage": "https://github.com/GuaiWuA/dsh-skill-bar#readme",
  "bugs": {
    "url": "https://github.com/GuaiWuA/dsh-skill-bar/issues"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./lib/index.js": "./lib/index.js",
    "./lib/client.js": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node build.mjs --check && node smoke-test.mjs",
    "test:browser": "node browser-check.mjs",
    "prepublishOnly": "node build.mjs --check && node smoke-test.mjs"
  },
  "dsh": {
    "verifiedAgainst": "0.2.0-rc.2",
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
