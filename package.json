{
  "name": "dsh-client-ui-skill-bar",
  "version": "0.1.0",
  "description": "Game-style skill bar for the DSH web GUI: browse the session skill catalog, keep favorites, and cast a skill into the composer as /<name>",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "dsh-plugin",
    "skill",
    "skills",
    "web-ui"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node build.mjs --check && node smoke-test.mjs",
    "test:browser": "node browser-check.mjs",
    "prepublishOnly": "node build.mjs --check && node smoke-test.mjs"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  }
}
